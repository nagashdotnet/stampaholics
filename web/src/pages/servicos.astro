---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import fabrics from '../data/fabrics.json';
---

<Layout title="Serviços & Guia de Tecidos — Stampaholics">
  <Navbar currentPath="/servicos" />

  <main class="page-content">
    <div class="container">
      <div class="page-header">
        <span class="eyebrow" data-i18n-pt="Engenharia Têxtil" data-i18n-en="Textile Engineering">Engenharia Têxtil</span>
        <h1 class="page-title" data-i18n-pt="Serviços & Guia de Bases Têxteis" data-i18n-en="Services & Fabric Catalog">Serviços & Guia de Bases Têxteis</h1>
        <p class="page-desc" data-i18n-pt="Da calandragem em rolo ao corte guiado por visão computacional: conheça nossos processos industriais e as bases disponíveis para a sua produção." data-i18n-en="From rotary roll calendering to vision-guided laser cutting: discover our manufacturing processes and available fabric substrates.">
          Da calandragem em rolo ao corte guiado por visão computacional: conheça nossos processos industriais e as bases disponíveis para a sua produção.
        </p>
      </div>

      <!-- Detalhamento dos 3 Serviços -->
      <section class="services-deep-section">
        <div class="service-block">
          <div class="service-block-meta">
            <span class="block-num">01</span>
            <h2 class="block-title" data-i18n-pt="Sublimação Contínua em Rolo (Por Metro)" data-i18n-en="Continuous Roll Sublimation (Per Meter)">Sublimação Contínua em Rolo (Por Metro)</h2>
          </div>
          <div class="service-block-body">
            <p data-i18n-pt="Transferência térmica de alta precisão em calandra industrial a 210°C. O corante sublimático gasoso penetra diretamente nas fibras sintéticas do poliéster, garantindo toque absolutamente zero, flexibilidade total e resistência à lavagem contínua sem desbotamento." data-i18n-en="High-precision rotary thermal transfer at 210°C. Disperse dye bonds directly with polymer fibers, achieving zero hand-feel, full drape flexibility, and permanent wash-fastness without fading.">
              Transferência térmica de alta precisão em calandra industrial a 210°C. O corante sublimático gasoso penetra diretamente nas fibras sintéticas do poliéster, garantindo toque absolutamente zero, flexibilidade total e resistência à lavagem contínua sem desbotamento.
            </p>
            <ul class="block-specs">
              <li><strong>Largura Útil:</strong> Até 1,60m sem emenda</li>
              <li><strong>Resolução de Impressão:</strong> Até 1440 DPI em cabeçotes industriais</li>
              <li><strong>Perfil de Cor:</strong> Espaço de cor expandido com pretos densos e cores neon</li>
            </ul>
          </div>
        </div>

        <div class="service-block">
          <div class="service-block-meta">
            <span class="block-num">02</span>
            <h2 class="block-title" data-i18n-pt="Corte a Laser Óptico Guiado por Câmera" data-i18n-en="Vision-Guided Optical Laser Cutting">Corte a Laser Óptico Guiado por Câmera</h2>
          </div>
          <div class="service-block-body">
            <p data-i18n-pt="Mesas de corte a laser equipadas com câmeras CCD de visão computacional que escaneiam marcas de registro ou os contornos da estampa em tempo real, compensando qualquer micro-distorção elástica do tecido durante o corte." data-i18n-en="Laser cutting tables equipped with CCD computer vision that scans fiducial marks and print outlines in real-time, instantly adjusting for fabric stretch and dimensional shifts.">
              Mesas de corte a laser equipadas com câmeras CCD de visão computacional que escaneiam marcas de registro ou os contornos da estampa em tempo real, compensando qualquer micro-distorção elástica do tecido durante o corte.
            </p>
            <ul class="block-specs">
              <li><strong>Selagem Térmica:</strong> O feixe a laser cauteriza as pontas dos fios, eliminando 100% do desfiamento</li>
              <li><strong>Precisão Milimétrica:</strong> Encaixe exato de mangas, golas e frente/costas para confecção</li>
              <li><strong>Peças Prontas:</strong> Entregamos o lote cortado peça por peça pronto para a costura</li>
            </ul>
          </div>
        </div>

        <div class="service-block">
          <div class="service-block-meta">
            <span class="block-num">03</span>
            <h2 class="block-title" data-i18n-pt="Confecção & Acabamento Industrial" data-i18n-en="Apparel Assembly & Industrial Sewing">Confecção & Acabamento Industrial</h2>
          </div>
          <div class="service-block-body">
            <p data-i18n-pt="Montagem completa das peças com linhas de costura especiais (overloque de 4 fios, pesponto galoneira, bainha italiana e zíper invisível). Desenvolvemos desde o corte até a embalagem individual etiquetada." data-i18n-en="Complete apparel assembly featuring reinforced overlock seams, flatlock stitching, fine rolled hems, and hidden zippers, delivering individually polybagged garments.">
              Montagem completa das peças com linhas de costura especiais (overloque de 4 fios, pesponto galoneira, bainha italiana e zíper invisível). Desenvolvemos desde o corte até a embalagem individual etiquetada.
            </p>
            <ul class="block-specs">
              <li><strong>Controle de Qualidade:</strong> Revisão peça a peça antes do despacho</li>
              <li><strong>Etiquetagem:</strong> Aplicação de tags com grade de tamanho (P ao XG)</li>
              <li><strong>Logística:</strong> Embalagem por lotes setorizados para agilizar eventos</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Guia Completo de Tecidos STAMPFY -->
      <section class="fabrics-guide-section">
        <div class="section-title-row">
          <div>
            <span class="eyebrow" data-i18n-pt="Acervo STAMPFY" data-i18n-en="STAMPFY Swatch Library">Acervo STAMPFY</span>
            <h2 class="section-h2" data-i18n-pt="Guia Completo de Tecidos" data-i18n-en="Complete Fabric Guide">Guia Completo de Tecidos</h2>
          </div>
        </div>

        <div class="fabrics-table-grid">
          {fabrics.map((f) => (
            <div class="fabric-item-card">
              <div class="fabric-top">
                <h3 class="fabric-title">{f.name}</h3>
                <span class="fabric-weight">{f.weight}</span>
              </div>
              <p class="fabric-comp-txt">{f.composition}</p>

              <div class="fabric-meta-pair">
                <span class="meta-k" data-i18n-pt="Toque & Caimento" data-i18n-en="Hand & Drape">Toque & Caimento</span>
                <span class="meta-v">{f.touch}</span>
              </div>

              <div class="fabric-meta-pair">
                <span class="meta-k" data-i18n-pt="Aplicações Indicadas" data-i18n-en="Best Applications">Aplicações Indicadas</span>
                <span class="meta-v highlight">{f.applications}</span>
              </div>

              <div class="fabric-meta-pair">
                <span class="meta-k" data-i18n-pt="Diferencial" data-i18n-en="Feature">Diferencial</span>
                <span class="meta-v">{f.features}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <WhatsAppButton />
  <Footer />
</Layout>

<style>
  .page-content {
    padding-top: 140px;
    padding-bottom: 90px;
  }

  .page-header {
    max-width: 680px;
    margin-bottom: 56px;
  }

  .page-title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 12px;
  }

  .page-desc {
    font-size: 15.5px;
    color: var(--text-white-muted);
    line-height: 1.6;
  }

  /* Serviços em Profundidade */
  .services-deep-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-bottom: 80px;
  }

  .service-block {
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 36px;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 32px;
  }

  .service-block-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .block-num {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    color: var(--brand-pink);
  }

  .block-title {
    font-size: 22px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.25;
  }

  .service-block-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 14.5px;
    color: var(--text-white-muted);
    line-height: 1.65;
  }

  .block-specs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    padding: 16px;
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    color: #E2E8F0;
  }

  .block-specs strong {
    color: var(--brand-green);
    margin-right: 6px;
  }

  /* Guia de Tecidos */
  .fabrics-guide-section {
    padding-top: 40px;
  }

  .section-title-row {
    margin-bottom: 36px;
  }

  .section-h2 {
    font-size: 28px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .fabrics-table-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  .fabric-item-card {
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fabric-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .fabric-title {
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .fabric-weight {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--brand-green);
  }

  .fabric-comp-txt {
    font-size: 12.5px;
    color: var(--text-white-muted);
  }

  .fabric-meta-pair {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-k {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--brand-pink);
    letter-spacing: 0.04em;
  }

  .meta-v {
    font-size: 13px;
    color: #CBD5E1;
  }

  .meta-v.highlight {
    color: #FFFFFF;
    font-weight: 500;
  }

  @media (max-width: 800px) {
    .service-block {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .fabrics-table-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
