---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProductCardMinimal from '../components/ProductCardMinimal.astro';
import ProductDrawer from '../components/ProductDrawer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import products from '../data/products.json';
---

<Layout title="Produtos & Soluções Têxteis — Stampaholics">
  <Navbar currentPath="/produtos" />

  <main class="page-content">
    <div class="container">
      <div class="page-header">
        <span class="eyebrow" data-i18n-pt="Catálogo Completo" data-i18n-en="Full Catalog">Catálogo Completo</span>
        <h1 class="page-title" data-i18n-pt="Produtos & Linha de Confecção" data-i18n-en="Products & Custom Apparel">Produtos & Linha de Confecção</h1>
        <p class="page-desc" data-i18n-pt="Todos os produtos são confeccionados em tecidos nobres com sublimação total e corte óptico a laser. Selecione qualquer item para conferir a ficha técnica e solicitar cotação." data-i18n-en="All products are manufactured with high-definition digital sublimation and optical laser cutting. Click any item to view specifications and request a quote.">
          Todos os produtos são confeccionados em tecidos nobres com sublimação total e corte óptico a laser. Selecione qualquer item para conferir a ficha técnica e solicitar cotação.
        </p>
      </div>

      <div class="products-full-grid">
        {products.map((p) => (
          <ProductCardMinimal id={p.id} name={p.name} name_en={p.name_en} image={p.image} />
        ))}
      </div>
    </div>
  </main>

  <ProductDrawer />
  <WhatsAppButton />
  <Footer />
</Layout>

<style>
  .page-content {
    padding-top: 140px;
    padding-bottom: 90px;
  }

  .page-header {
    max-width: 680px;
    margin-bottom: 56px;
  }

  .page-title {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 12px;
  }

  .page-desc {
    font-size: 15.5px;
    color: var(--text-white-muted);
    line-height: 1.6;
  }

  .products-full-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px;
  }
</style>
