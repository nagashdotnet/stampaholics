---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import cases from '../data/cases.json';
---

<Layout title="Clientes & Cases — Stampaholics">
  <Navbar currentPath="/clientes" />

  <main>
    <!-- Header Clientes -->
    <section class="clients-hero-section section-petrol">
      <div class="container">
        <span class="eyebrow-intheknow" data-i18n-pt="cases & portfólio" data-i18n-en="cases & portfolio">cases & portfólio</span>
        <h1 class="page-title" data-i18n-pt="Grandes Produções Entregues com Rigor" data-i18n-en="Major Productions Delivered on Time">Grandes Produções Entregues com Rigor</h1>
        <p class="page-lead" data-i18n-pt="Parceiros de agências de live marketing, federações esportivas, camarotes de carnaval e marcas que não podem correr o risco de atrasos ou desvios de cor." data-i18n-en="Trusted by live marketing agencies, marathon federations, carnival VIP areas, and fashion brands where delays and color drift are not an option.">
          Parceiros de agências de live marketing, federações esportivas, camarotes de carnaval e marcas que não podem correr o risco de atrasos ou desvios de cor.
        </p>
      </div>
    </section>

    <!-- Galeria de Fotos de Produção & Aplicação Real (Espaço Fotográfico Solicitado) -->
    <section class="boutique-section section-white bg-geometric-pattern">
      <div class="container">
        <div class="section-title-row">
          <div>
            <span class="eyebrow-intheknow" data-i18n-pt="em produção" data-i18n-en="on the floor">em produção</span>
            <h2 class="section-h2" data-i18n-pt="Cases de Fábrica & Aplicações" data-i18n-en="Factory Cases & Real Applications">Cases de Fábrica & Aplicações</h2>
          </div>
        </div>

        <div class="cases-photo-gallery">
          <div class="case-photo-item">
            <img src="/photos/factory-4.jpg" alt="Controle de qualidade e corte" class="case-img" />
            <div class="case-photo-overlay">
              <span class="font-intheknow">Acabamento & Laser</span>
              <p>Revisão peça a peça antes do envio</p>
            </div>
          </div>

          <div class="case-photo-item">
            <img src="/photos/factory-5.jpg" alt="Grandes tiragens em rolo" class="case-img" />
            <div class="case-photo-overlay">
              <span class="font-intheknow">Grandes Volumes</span>
              <p>Produção contínua para eventos e festivais</p>
            </div>
          </div>

          <div class="case-photo-item">
            <img src="/photos/factory-6.jpg" alt="Cores saturadas em alta definição" class="case-img" />
            <div class="case-photo-overlay">
              <span class="font-intheknow">Fidelidade Cromática</span>
              <p>Preto denso e passagem total da estampa</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lista Detalhada de Cases -->
    <section class="boutique-section-dark section-petrol">
      <div class="container">
        <div class="cases-vertical-list">
          {cases.map((c) => (
            <article class="case-expanded-card">
              <div class="case-header-line">
                <span class="case-badge-segment font-intheknow">{c.segment}</span>
                <span class="case-volume-badge">{c.volume}</span>
              </div>
              <h2 class="case-h2">{c.title}</h2>
              <p class="case-p">{c.description}</p>
              <div class="case-footer-line">
                <div class="client-info">
                  <span class="client-label" data-i18n-pt="Segmento:" data-i18n-en="Segment:">Segmento:</span>
                  <span class="client-name">{c.client}</span>
                </div>
                <div class="case-metric-highlight font-mono">
                  <span>✦ {c.metric}</span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Box de Chamada -->
        <div class="clients-cta-box">
          <h3 class="font-intheknow" style="font-size:32px; color:#FFFFFF;" data-i18n-pt="vamos produzir seu próximo projeto?" data-i18n-en="let's manufacture your next project?">vamos produzir seu próximo projeto?</h3>
          <p data-i18n-pt="Envie seu briefing para nossos técnicos alinharem a base têxtil ideal e o cronograma de entrega." data-i18n-en="Share your briefing with our technical leads to map the best fabric substrate and delivery schedule.">
            Envie seu briefing para nossos técnicos alinharem a base têxtil ideal e o cronograma de entrega.
          </p>
          <a href="https://wa.me/5511999999999?text=Ol%C3%A1!%20Gostaria%20de%20conversar%20sobre%20um%20projeto%20comercial%20com%20a%20Stampaholics." target="_blank" rel="noopener noreferrer" class="btn-boutique-primary font-intheknow">
            <span data-i18n-pt="solicitar orçamento prioritário" data-i18n-en="request priority quote">solicitar orçamento prioritário</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <WhatsAppButton />
  <Footer />
</Layout>

<style>
  .clients-hero-section {
    padding-top: 150px;
    padding-bottom: 70px;
  }

  .page-title {
    font-size: clamp(34px, 4.2vw, 48px);
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 14px;
  }

  .page-lead {
    font-size: 16.5px;
    color: var(--text-white-muted);
    line-height: 1.6;
    max-width: 680px;
  }

  .boutique-section {
    padding: 80px 0;
  }

  .boutique-section-dark {
    padding: 80px 0 100px;
    background: var(--bg-dark-surface);
  }

  .section-h2 {
    font-size: 32px;
    font-weight: 700;
    color: var(--brand-petrol-dark);
  }

  /* Galeria de Fotos de Cases */
  .cases-photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .case-photo-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 280px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-boutique);
  }

  .case-photo-item:hover .case-img {
    transform: scale(1.06);
  }

  .case-photo-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(11, 23, 28, 0.9) 0%, transparent 100%);
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .case-photo-overlay span {
    font-size: 20px;
    color: var(--brand-pink);
  }

  .case-photo-overlay p {
    font-size: 13px;
    color: #CBD5E1;
  }

  /* Lista de Cards */
  .cases-vertical-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 64px;
  }

  .case-expanded-card {
    background: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .case-header-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .case-badge-segment {
    font-size: 16px;
    color: var(--brand-pink);
  }

  .case-volume-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--brand-green);
    background: rgba(31, 179, 128, 0.08);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .case-h2 {
    font-size: 22px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .case-p {
    font-size: 14.5px;
    color: var(--text-white-muted);
    line-height: 1.65;
  }

  .case-footer-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--border-dark);
    flex-wrap: wrap;
    gap: 12px;
  }

  .client-info {
    display: flex;
    gap: 6px;
    font-size: 13px;
  }

  .client-label {
    color: var(--text-white-muted);
  }

  .client-name {
    color: #FFFFFF;
    font-weight: 600;
  }

  .case-metric-highlight {
    font-size: 12px;
    font-weight: 600;
    color: var(--brand-green);
  }

  .clients-cta-box {
    background: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    padding: 48px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .clients-cta-box p {
    font-size: 15px;
    color: var(--text-white-muted);
    max-width: 520px;
  }

  @media (max-width: 640px) {
    .case-expanded-card {
      padding: 24px;
    }
  }
</style>
