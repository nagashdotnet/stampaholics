---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProductCardMinimal from '../components/ProductCardMinimal.astro';
import ProductDrawer from '../components/ProductDrawer.astro';
import Calculator from '../components/Calculator.astro';
import SilkWaveShader from '../components/shaders/SilkWaveShader.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import products from '../data/products.json';
import cases from '../data/cases.json';

const featuredProducts = products.slice(0, 8);
---

<Layout title="Stampaholics — Impressão Digital Têxtil por Sublimação">
  <Navbar currentPath="/" />

  <main>
    <!-- Hero com WebGL Silk Wave Shader (Ondulação de Seda ao Vivo) -->
    <section class="boutique-hero-shader section-petrol">
      <SilkWaveShader />

      <div class="container hero-shader-grid">
        <div class="hero-text-pane">
          <span class="eyebrow-intheknow" data-i18n-pt="estamparia digital & corte a laser" data-i18n-en="digital printing & laser cutting">estamparia digital & corte a laser</span>
          <h1 class="hero-headline" data-i18n-pt="Transformamos ideias em tecido com intensidade e precisão." data-i18n-en="Transforming visual ideas into fabric with vibrant color and precision.">
            Transformamos ideias em tecido com intensidade e precisão.
          </h1>
          <p class="hero-lead" data-i18n-pt="Sublimação contínua de alta definição para eventos, festivais, circuitos de corrida e marcas autorais. Toque zero, cores que não desbotam e corte óptico a laser." data-i18n-en="High-definition continuous sublimation for festivals, marathons, and fashion brands. Zero hand-feel, permanent colors, and precision laser cutting.">
            Sublimação contínua de alta definição para eventos, festivais, circuitos de corrida e marcas autorais. Toque zero, cores que não desbotam e corte óptico a laser.
          </p>

          <div class="hero-actions">
            <a href="/produtos" class="btn-boutique-primary" data-i18n-pt="Conhecer Produtos" data-i18n-en="Explore Products">Conhecer Produtos</a>
            <a href="#calculadora" class="btn-boutique-ghost" data-i18n-pt="Simular Orçamento" data-i18n-en="Price Simulator">Simular Orçamento</a>
          </div>
        </div>

        <div class="hero-visual-pane">
          <!-- Produto em Destaque Flutuante com Sombra de Contato -->
          <div class="hero-float-card product-contact-shadow">
            <img src="/products/Kit_Corrida_DryFit_Sacochila.png" alt="Stampaholics Destaque" class="hero-float-img" />
          </div>
        </div>
      </div>
    </section>

    <!-- Seção de Produtos em Fundo Branco Puro (Estilo _old/v2 com Leve Movimento) -->
    <section class="boutique-section section-white bg-geometric-pattern">
      <div class="container">
        <div class="section-title-row">
          <div>
            <span class="eyebrow-intheknow" data-i18n-pt="nossa linha" data-i18n-en="our line">nossa linha</span>
            <h2 class="section-h2" data-i18n-pt="Produtos em Destaque" data-i18n-en="Featured Products">Produtos em Destaque</h2>
          </div>
          <a href="/produtos" class="section-more-link" data-i18n-pt="ver todos os 24 produtos →" data-i18n-en="view all 24 products →">ver todos os 24 produtos →</a>
        </div>

        <div class="minimal-products-grid">
          {featuredProducts.map((p) => (
            <ProductCardMinimal id={p.id} name={p.name} name_en={p.name_en} image={p.image} />
          ))}
        </div>
      </div>
    </section>

    <!-- Seção de Serviços em Azul Petróleo com Grafismos da Marca -->
    <section class="boutique-section-dark section-petrol">
      <div class="container">
        <div class="section-title-row">
          <div>
            <span class="eyebrow-intheknow" data-i18n-pt="capacidade fabril" data-i18n-en="plant capacity">capacidade fabril</span>
            <h2 class="section-h2" data-i18n-pt="Nossos Serviços" data-i18n-en="Our Services">Nossos Serviços</h2>
          </div>
          <a href="/servicos" class="section-more-link" data-i18n-pt="ver guia de tecidos →" data-i18n-en="view fabric guide →">ver guia de tecidos →</a>
        </div>

        <div class="services-trio-grid">
          <div class="service-trio-card">
            <span class="service-index font-mono">01</span>
            <h3 class="service-card-title" data-i18n-pt="Sublimação por Metro" data-i18n-en="Roll Sublimation">Sublimação por Metro</h3>
            <p class="service-card-desc" data-i18n-pt="Calandragem industrial contínua a 210°C em rolos inteiros de tecido sintético, garantindo pretos profundos e toque zero." data-i18n-en="Continuous rotary heat transfer on continuous fabric rolls with deep blacks and vivid colors.">
              Calandragem industrial contínua a 210°C em rolos inteiros de tecido sintético, garantindo pretos profundos e toque zero.
            </p>
          </div>

          <div class="service-trio-card">
            <span class="service-index font-mono">02</span>
            <h3 class="service-card-title" data-i18n-pt="Corte a Laser Óptico" data-i18n-en="Laser Cutting">Corte a Laser Óptico</h3>
            <p class="service-card-desc" data-i18n-pt="Mesas automatizadas com câmeras CCD que leem a estampa e cortam milimetricamente selando as bordas sem desfiar." data-i18n-en="Automated vision-guided laser cutting that seals edges with millimeter precision, eliminating fraying.">
              Mesas automatizadas com câmeras CCD que leem a estampa e cortam milimetricamente selando as bordas sem desfiar.
            </p>
          </div>

          <div class="service-trio-card">
            <span class="service-index font-mono">03</span>
            <h3 class="service-card-title" data-i18n-pt="Confecção Especializada" data-i18n-en="Custom Apparel">Confecção Especializada</h3>
            <p class="service-card-desc" data-i18n-pt="Montagem completa: abadás anatômicos, camisetas esportivas, bolsas e almofadas com costura reforçada e entrega etiquetada." data-i18n-en="Complete apparel assembly: ergonomic tops, sportswear, bags, and cushions delivered individually tagged.">
              Montagem completa: abadás anatômicos, camisetas esportivas, bolsas e almofadas com costura reforçada e entrega etiquetada.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Calculadora Oficial Integrada -->
    <Calculator />

    <!-- Cases de Clientes em Seção Clara -->
    <section class="boutique-section section-white bg-geometric-pattern">
      <div class="container">
        <div class="section-title-row">
          <div>
            <span class="eyebrow-intheknow" data-i18n-pt="grandes marcas" data-i18n-en="featured clients">grandes marcas</span>
            <h2 class="section-h2" data-i18n-pt="Projetos Entregues" data-i18n-en="Delivered Projects">Projetos Entregues</h2>
          </div>
          <a href="/clientes" class="section-more-link" data-i18n-pt="ver todos os cases →" data-i18n-en="view all case studies →">ver todos os cases →</a>
        </div>

        <div class="cases-dual-grid">
          {cases.slice(0, 2).map((c) => (
            <div class="case-boutique-card" style="background:#FFFFFF; border: 1px solid rgba(226,232,240,0.9); box-shadow: 0 10px 25px rgba(0,0,0,0.04);">
              <span class="case-segment">{c.segment}</span>
              <h3 class="case-title" style="color:#0F1D23;">{c.title}</h3>
              <p class="case-desc" style="color:#64748B;">{c.description}</p>
              <div class="case-meta-row" style="border-top-color:#E2E8F0;">
                <span class="case-vol" style="color:#142830;">{c.volume}</span>
                <span class="case-metric-chip">{c.metric}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <ProductDrawer />
  <WhatsAppButton />
  <Footer />
</Layout>

<style>
  .boutique-hero-shader {
    position: relative;
    padding-top: 150px;
    padding-bottom: 90px;
    overflow: hidden;
  }

  .hero-shader-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-headline {
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.12;
    margin-bottom: 18px;
  }

  .hero-lead {
    font-size: 16.5px;
    color: var(--text-white-muted);
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero-float-card {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px;
    margin-left: auto;
    animation: floatGentle 5s ease-in-out infinite;
  }

  @keyframes floatGentle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .hero-float-img {
    max-height: 90%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 24px rgba(13, 25, 30, 0.16));
  }

  .boutique-section {
    padding: 90px 0;
  }

  .boutique-section-dark {
    padding: 90px 0;
    background: var(--bg-dark-surface);
    border-top: 1px solid var(--border-dark);
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .section-h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 700;
  }

  .section-more-link {
    font-size: 17px;
    color: var(--brand-pink);
    transition: opacity 0.2s;
  }

  .minimal-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px;
  }

  .services-trio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .service-trio-card {
    background: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .service-index {
    font-size: 24px;
    color: var(--brand-green);
  }

  .service-card-title {
    font-size: 19px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .service-card-desc {
    font-size: 14px;
    color: var(--text-white-muted);
    line-height: 1.6;
  }

  .cases-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .case-boutique-card {
    border-radius: var(--radius-md);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .case-segment {
    font-size: 14px;
    color: var(--brand-pink);
  }

  .case-title {
    font-size: 20px;
    font-weight: 700;
  }

  .case-desc {
    font-size: 14px;
    line-height: 1.6;
  }

  .case-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1px solid;
  }

  .case-vol {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }

  .case-metric-chip {
    font-size: 12px;
    color: var(--brand-green-dark);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .hero-shader-grid {
      grid-template-columns: 1fr;
    }
    .hero-float-card {
      margin: 0 auto;
    }
    .cases-dual-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
