---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProductCardMinimal from '../components/ProductCardMinimal.astro';
import ProductDrawer from '../components/ProductDrawer.astro';
import Calculator from '../components/Calculator.astro';
import HeartCanvas3D from '../components/HeartCanvas3D.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import products from '../data/products.json';
import cases from '../data/cases.json';

// Seleciona 8 produtos de maior destaque para a Home
const featuredProducts = products.slice(0, 8);
---

<Layout title="Stampaholics — Estúdio de Sublimação Digital & Laser Cut">
  <Navbar currentPath="/" />

  <main>
    <!-- Hero Boutique Sóbrio -->
    <section class="boutique-hero">
      <div class="container hero-grid">
        <div class="hero-text-pane">
          <span class="eyebrow" data-i18n-pt="Estúdio de Sublimação Têxtil" data-i18n-en="Textile Sublimation Studio">Estúdio de Sublimação Têxtil</span>
          <h1 class="hero-headline" data-i18n-pt="Impressão digital em tecido para quem exige fidelidade e escala." data-i18n-en="Digital textile printing for those who demand color fidelity and scale.">
            Impressão digital em tecido para quem exige fidelidade e escala.
          </h1>
          <p class="hero-lead" data-i18n-pt="Sublimação contínua, corte a laser e acabamento industrial para eventos, festivais, circuitos de corrida e marcas de moda." data-i18n-en="Continuous sublimation, precision laser cutting, and industrial finishing for festivals, marathons, and fashion labels.">
            Sublimação contínua, corte a laser e acabamento industrial para eventos, festivais, circuitos de corrida e marcas de moda.
          </p>

          <div class="hero-actions">
            <a href="/produtos" class="btn-boutique-primary" data-i18n-pt="Explorar Produtos" data-i18n-en="Explore Products">Explorar Produtos</a>
            <a href="#calculadora" class="btn-boutique-ghost" data-i18n-pt="Simular Preço" data-i18n-en="Simulate Price">Simular Preço</a>
          </div>
        </div>

        <div class="hero-visual-pane">
          <HeartCanvas3D />
        </div>
      </div>
    </section>

    <!-- Destaques de Produtos (Showroom Curado) -->
    <section class="boutique-section">
      <div class="container">
        <div class="section-title-row">
          <div>
            <span class="eyebrow" data-i18n-pt="Showroom" data-i18n-en="Showroom">Showroom</span>
            <h2 class="section-h2" data-i18n-pt="Produtos em Destaque" data-i18n-en="Featured Products">Produtos em Destaque</h2>
          </div>
          <a href="/produtos" class="section-more-link" data-i18n-pt="Ver todos os 24 produtos →" data-i18n-en="View all 24 products →">Ver todos os 24 produtos →</a>
        </div>

        <div class="minimal-products-grid">
          {featuredProducts.map((p) => (
            <ProductCardMinimal id={p.id} name={p.name} name_en={p.name_en} image={p.image} />
          ))}
        </div>
      </div>
    </section>

    <!-- 3 Pilares de Serviços -->
    <section class="boutique-section-dark">
      <div class="container">
        <div class="section-title-row">
          <div>
            <span class="eyebrow" data-i18n-pt="Capacidade Produtiva" data-i18n-en="Production Capacity">Capacidade Produtiva</span>
            <h2 class="section-h2" data-i18n-pt="Nossos Serviços" data-i18n-en="Our Services">Nossos Serviços</h2>
          </div>
          <a href="/servicos" class="section-more-link" data-i18n-pt="Ver especificações e tecidos →" data-i18n-en="View specs & fabrics →">Ver especificações e tecidos →</a>
        </div>

        <div class="services-trio-grid">
          <div class="service-trio-card">
            <span class="service-index">01</span>
            <h3 class="service-card-title" data-i18n-pt="Sublimação por Metro" data-i18n-en="Roll-to-Roll Sublimation">Sublimação por Metro</h3>
            <p class="service-card-desc" data-i18n-pt="Calandragem contínua em rolos contínuos de tecido com fidelidade cromática e preto profundo em alta temperatura." data-i18n-en="Continuous rotary heat transfer on continuous fabric rolls with deep blacks and vivid color gamut.">
              Calandragem contínua em rolos contínuos de tecido com fidelidade cromática e preto profundo em alta temperatura.
            </p>
          </div>

          <div class="service-trio-card">
            <span class="service-index">02</span>
            <h3 class="service-card-title" data-i18n-pt="Corte a Laser Óptico" data-i18n-en="Optical Laser Cutting">Corte a Laser Óptico</h3>
            <p class="service-card-desc" data-i18n-pt="Câmeras ópticas que leem o desenho impresso e realizam corte milimétrico com bordas seladas termicamente sem desfiar." data-i18n-en="Vision-guided laser cutting that seals fabric edges with millimeter precision, eliminating fraying.">
              Câmeras ópticas que leem o desenho impresso e realizam corte milimétrico com bordas seladas termicamente sem desfiar.
            </p>
          </div>

          <div class="service-trio-card">
            <span class="service-index">03</span>
            <h3 class="service-card-title" data-i18n-pt="Confecção & Acabamento" data-i18n-en="Apparel & Finishing">Confecção & Acabamento</h3>
            <p class="service-card-desc" data-i18n-pt="Costura industrial especializada em peças esportivas e promocionais: golas anatômicas, zíperes invisíveis e ilhoses." data-i18n-en="Industrial sewing for sportswear and promotional items: ergonomic collars, hidden zippers, and eyelets.">
              Costura industrial especializada em peças esportivas e promocionais: golas anatômicas, zíperes invisíveis e ilhoses.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Calculadora Oficial Integrada -->
    <Calculator />

    <!-- Cases de Clientes em Destaque -->
    <section class="boutique-section">
      <div class="container">
        <div class="section-title-row">
          <div>
            <span class="eyebrow" data-i18n-pt="Cases de Sucesso" data-i18n-en="Case Studies">Cases de Sucesso</span>
            <h2 class="section-h2" data-i18n-pt="Grandes Volumes Entregues" data-i18n-en="Enterprise Projects Delivered">Grandes Volumes Entregues</h2>
          </div>
          <a href="/clientes" class="section-more-link" data-i18n-pt="Ver todos os cases →" data-i18n-en="View all case studies →">Ver todos os cases →</a>
        </div>

        <div class="cases-dual-grid">
          {cases.slice(0, 2).map((c) => (
            <div class="case-boutique-card">
              <span class="case-segment">{c.segment}</span>
              <h3 class="case-title">{c.title}</h3>
              <p class="case-desc">{c.description}</p>
              <div class="case-meta-row">
                <span class="case-vol">{c.volume}</span>
                <span class="case-metric-chip">{c.metric}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <ProductDrawer />
  <WhatsAppButton />
  <Footer />
</Layout>

<style>
  /* Hero Boutique */
  .boutique-hero {
    padding-top: 150px;
    padding-bottom: 90px;
    background: radial-gradient(circle at 75% 20%, rgba(39, 77, 94, 0.25) 0%, transparent 60%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-headline {
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.12;
    margin-bottom: 18px;
  }

  .hero-lead {
    font-size: 16.5px;
    color: var(--text-white-muted);
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero-stage {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px;
    margin-left: auto;
  }

  .hero-featured-img {
    max-height: 90%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 16px 28px rgba(13, 25, 30, 0.16));
  }

  /* Seções Gerais */
  .boutique-section {
    padding: 90px 0;
  }

  .boutique-section-dark {
    padding: 90px 0;
    background: var(--bg-dark-surface);
    border-top: 1px solid var(--border-dark);
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .section-h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 700;
    color: #FFFFFF;
  }

  .section-more-link {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--brand-pink);
    transition: opacity 0.2s;
  }

  .section-more-link:hover {
    opacity: 0.8;
  }

  /* Grid Minimalista de Produtos */
  .minimal-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px;
  }

  /* Grid dos 3 Serviços */
  .services-trio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .service-trio-card {
    background: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .service-index {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--brand-green);
    font-weight: 600;
  }

  .service-card-title {
    font-size: 19px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .service-card-desc {
    font-size: 14px;
    color: var(--text-white-muted);
    line-height: 1.6;
  }

  /* Grid de Cases */
  .cases-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .case-boutique-card {
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .case-segment {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--brand-pink);
    letter-spacing: 0.05em;
  }

  .case-title {
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .case-desc {
    font-size: 14px;
    color: var(--text-white-muted);
    line-height: 1.6;
  }

  .case-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--border-dark);
  }

  .case-vol {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
  }

  .case-metric-chip {
    font-size: 12px;
    color: var(--brand-green);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-stage {
      margin: 0 auto;
    }
    .cases-dual-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
