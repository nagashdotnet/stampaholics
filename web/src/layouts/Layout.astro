---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Stampaholics — Impressão Digital Têxtil por Sublimação",
  description = "Especialistas em sublimação total para eventos, corridas, marcas de moda e brindes corporativos. Alta definição de cores, tecidos tecnológicos e corte a laser."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/brand/stampaholics_icon.png" />
  
  <!-- OpenGraph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/brand/stampaholics_intheknow.png" />

  <!-- Global Styles -->
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
  <slot />
</body>
</html>
