---
---

<!-- Botão Flutuante de Cotação (Canto Inferior Direito) -->
<button class="cart-floating-btn" id="floating-cart-btn" aria-label="Ver itens do orçamento">
  <div class="cart-icon-wrap">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span class="floating-badge-counter" id="floating-cart-counter">0</span>
  </div>
  <span class="floating-btn-text">Orçamento</span>
</button>

<!-- Painel Lateral / Drawer do Carrinho -->
<div class="cart-overlay" id="cart-drawer-overlay">
  <div class="cart-drawer-panel" id="cart-drawer-panel">
    <div class="cart-header">
      <div class="cart-header-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <h3>Minha Lista de Cotação</h3>
      </div>
      <button class="cart-close-btn" id="cart-close-btn" aria-label="Fechar orçamento">✕</button>
    </div>

    <!-- Lista de Itens -->
    <div class="cart-body" id="cart-body">
      <div class="cart-empty-state" id="cart-empty-state">
        <div class="empty-icon">📦</div>
        <h4>Sua lista está vazia</h4>
        <p>Explore o catálogo ou use o simulador para adicionar itens ao seu pedido de cotação.</p>
      </div>

      <div class="cart-items-list" id="cart-items-list">
        <!-- Renderizado dinamicamente -->
      </div>
    </div>

    <!-- Rodapé de Finalização -->
    <div class="cart-footer" id="cart-footer" style="display: none;">
      <div class="client-info-box">
        <label for="cart-client-name">Seu Nome / Empresa:</label>
        <input type="text" id="cart-client-name" placeholder="Ex: Lucas / Agência XYZ" />
      </div>

      <div class="cart-actions">
        <button class="btn-primary send-whatsapp-btn" id="send-whatsapp-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>Cotar no WhatsApp</span>
        </button>

        <button class="btn-secondary clear-cart-btn" id="clear-cart-btn">
          Limpar Lista
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Botão Flutuante */
  .cart-floating-btn {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--brand-pink);
    color: #FFFFFF;
    padding: 12px 20px;
    border-radius: var(--radius-full);
    box-shadow: 0 8px 24px rgba(235, 44, 101, 0.4);
    transition: all 0.25s var(--ease-spring);
  }

  .cart-floating-btn:hover {
    background: var(--brand-pink-dark);
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 30px rgba(235, 44, 101, 0.5);
  }

  .cart-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .floating-badge-counter {
    position: absolute;
    top: -8px;
    right: -10px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #FFFFFF;
    color: var(--brand-pink-dark);
    font-size: 11px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--brand-pink);
  }

  .floating-btn-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
  }

  /* Overlay & Drawer */
  .cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(13, 29, 35, 0.5);
    backdrop-filter: blur(5px);
    z-index: 1010;
    display: none;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .cart-overlay.active {
    display: block;
    opacity: 1;
  }

  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background: #FFFFFF;
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.18);
    transform: translateX(100%);
    transition: transform 0.35s var(--ease-spring);
    display: flex;
    flex-direction: column;
  }

  .cart-overlay.active .cart-drawer-panel {
    transform: translateX(0%);
  }

  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cart-header-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-petrol-dark);
  }

  .cart-header-title h3 {
    font-size: 17px;
    font-weight: 700;
  }

  .cart-close-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .cart-close-btn:hover {
    background: #E2E8F0;
    color: var(--text-main);
  }

  .cart-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px 24px;
  }

  .cart-empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
  }

  .empty-icon {
    font-size: 42px;
    margin-bottom: 12px;
  }

  .cart-empty-state h4 {
    font-size: 16px;
    color: var(--brand-petrol);
    margin-bottom: 6px;
  }

  .cart-empty-state p {
    font-size: 13.5px;
    line-height: 1.5;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cart-item-row {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px;
    border-radius: var(--radius-sm);
    background: var(--bg-page);
    border: 1px solid var(--border-subtle);
  }

  .cart-item-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    background: #FFFFFF;
    border-radius: 4px;
    padding: 4px;
  }

  .cart-item-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cart-item-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--brand-petrol-dark);
  }

  .cart-item-meta {
    font-size: 12px;
    color: var(--text-muted);
  }

  .cart-item-remove {
    color: var(--text-light);
    font-size: 16px;
    padding: 4px;
    transition: color 0.2s;
  }

  .cart-item-remove:hover {
    color: var(--brand-pink);
  }

  .cart-footer {
    padding: 20px 24px;
    border-top: 1px solid var(--border-subtle);
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .client-info-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .client-info-box label {
    font-size: 12px;
    font-weight: 600;
    color: var(--brand-petrol);
  }

  .client-info-box input {
    padding: 9px 12px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    font-size: 13.5px;
    outline: none;
  }

  .client-info-box input:focus {
    border-color: var(--brand-green);
  }

  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .send-whatsapp-btn {
    width: 100%;
  }

  .clear-cart-btn {
    width: 100%;
    padding: 9px 14px;
    font-size: 13px;
  }
</style>

<script>
  interface CartItem {
    id: string;
    name: string;
    fabric: string;
    image: string;
    quantity: number;
    notes?: string;
  }

  let cart: CartItem[] = [];

  const floatingBtn = document.getElementById('floating-cart-btn');
  const openNavBtn = document.getElementById('open-cart-btn');
  const closeBtn = document.getElementById('cart-close-btn');
  const overlay = document.getElementById('cart-drawer-overlay');

  const navCounter = document.getElementById('cart-counter');
  const floatingCounter = document.getElementById('floating-cart-counter');

  const emptyState = document.getElementById('cart-empty-state');
  const itemsList = document.getElementById('cart-items-list');
  const footer = document.getElementById('cart-footer');
  const clientInput = document.getElementById('cart-client-name') as HTMLInputElement | null;
  const sendBtn = document.getElementById('send-whatsapp-btn');
  const clearBtn = document.getElementById('clear-cart-btn');

  function updateCounters() {
    const totalCount = cart.reduce((sum, it) => sum + it.quantity, 0);
    const uniqueCount = cart.length;

    if (navCounter) {
      navCounter.textContent = String(uniqueCount);
      navCounter.classList.toggle('has-items', uniqueCount > 0);
    }
    if (floatingCounter) {
      floatingCounter.textContent = String(uniqueCount);
    }
  }

  function renderCart() {
    updateCounters();

    if (!itemsList || !emptyState || !footer) return;

    if (cart.length === 0) {
      emptyState.style.display = 'block';
      itemsList.innerHTML = '';
      footer.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    footer.style.display = 'flex';
    itemsList.innerHTML = '';

    cart.forEach((item, idx) => {
      const row = document.createElement('div');
      row.className = 'cart-item-row';
      row.innerHTML = `
        <img src="${item.image}" alt="${item.name}" class="cart-item-img" />
        <div class="cart-item-info">
          <span class="cart-item-name">${item.name}</span>
          <span class="cart-item-meta">${item.quantity} un. · ${item.fabric}</span>
          ${item.notes ? `<small style="font-size:11px;color:#64748B;">Obs: ${item.notes}</small>` : ''}
        </div>
        <button class="cart-item-remove" data-idx="${idx}" title="Remover item">✕</button>
      `;

      row.querySelector('.cart-item-remove')?.addEventListener('click', () => {
        cart.splice(idx, 1);
        renderCart();
      });

      itemsList.appendChild(row);
    });
  }

  function openCart() {
    if (!overlay) return;
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeCart() {
    if (!overlay) return;
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (floatingBtn) floatingBtn.addEventListener('click', openCart);
  if (openNavBtn) openNavBtn.addEventListener('click', openCart);
  if (closeBtn) closeBtn.addEventListener('click', closeCart);
  if (overlay) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeCart();
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      cart = [];
      renderCart();
    });
  }

  // Ouvinte de evento customizado vindo de qualquer botão da página
  window.addEventListener('stampaholics:add-to-cart', ((e: CustomEvent<CartItem>) => {
    const newItem = e.detail;
    const existing = cart.find((i) => i.id === newItem.id);

    if (existing) {
      existing.quantity += newItem.quantity;
      if (newItem.notes) existing.notes = newItem.notes;
    } else {
      cart.push(newItem);
    }

    renderCart();
    openCart();
  }) as EventListener);

  // Escuta os botões "+ Orçar" dos cards diretamente
  document.querySelectorAll('.add-to-quote-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const id = el.getAttribute('data-id') || '';
      const name = el.getAttribute('data-name') || '';
      const fabric = el.getAttribute('data-fabric') || '';
      const image = el.getAttribute('data-image') || '';

      window.dispatchEvent(
        new CustomEvent('stampaholics:add-to-cart', {
          detail: {
            id,
            name,
            fabric,
            image,
            quantity: 50
          }
        })
      );
    });
  });

  // Finalizar no WhatsApp
  if (sendBtn) {
    sendBtn.addEventListener('click', () => {
      if (cart.length === 0) return;

      const clientName = clientInput && clientInput.value.trim() ? clientInput.value.trim() : 'Cliente';
      
      let msg = `*Olá, Stampaholics! Gostaria de um orçamento.*\n\n`;
      msg += `👤 *Solicitante:* ${clientName}\n`;
      msg += `📋 *Itens Selecionados:*\n`;

      cart.forEach((it, i) => {
        msg += `\n${i + 1}. *${it.name}*\n`;
        msg += `   • Quantidade: ${it.quantity} unidades/metros\n`;
        msg += `   • Tecido Base: ${it.fabric}\n`;
        if (it.notes) msg += `   • Obs: ${it.notes}\n`;
      });

      msg += `\n💬 *Poderiam me informar prazo de produção e valores atualizados?*`;

      const encoded = encodeURIComponent(msg);
      // Número comercial oficial
      const whatsappUrl = `https://wa.me/5511999999999?text=${encoded}`;
      window.open(whatsappUrl, '_blank');
    });
  }

  renderCart();
</script>
