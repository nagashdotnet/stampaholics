---
---

<div class="silk-shader-container" id="silk-shader-wrap">
  <canvas id="silk-shader-canvas" class="silk-canvas"></canvas>
  <div class="shader-overlay"></div>
</div>

<style>
  .silk-shader-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .silk-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    opacity: 0.65;
  }

  .shader-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 50% 50%, transparent 20%, rgba(15, 29, 35, 0.85) 100%);
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('silk-shader-canvas') as HTMLCanvasElement | null;
  const wrap = document.getElementById('silk-shader-wrap');

  if (canvas && wrap) {
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
    renderer.setSize(wrap.clientWidth, wrap.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

    // Shader de Tecido / Seda Fluida (Cloth Wave)
    const vertexShader = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = vec4(position, 1.0);
      }
    `;

    const fragmentShader = `
      uniform float uTime;
      uniform vec2 uMouse;
      uniform vec2 uResolution;
      varying vec2 vUv;

      // Simplex noise 2D
      vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }
      float snoise(vec2 v){
        const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
        vec2 i  = floor(v + dot(v, C.yy) );
        vec2 x0 = v -   i + dot(i, C.xx);
        vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
        vec4 x12 = x0.xyxy + C.xxzz;
        x12.xy -= i1;
        i = mod(i, 289.0);
        vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0 )) + i.x + vec3(0.0, i1.x, 1.0 ));
        vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
        m = m*m ;
        m = m*m ;
        vec3 x = 2.0 * fract(p * C.www) - 1.0;
        vec3 h = abs(x) - 0.5;
        vec3 ox = floor(x + 0.5);
        vec3 a0 = x - ox;
        m *= 1.79284291400159 - 0.85373472095314 * ( a0*a0 + h*h );
        vec3 g;
        g.x  = a0.x  * x0.x  + h.x  * x0.y;
        g.yz = a0.yz * x12.xz + h.yz * x12.yw;
        return 130.0 * dot(m, g);
      }

      void main() {
        vec2 uv = vUv;
        vec2 mouseEffect = (uMouse - uv) * 0.15;
        
        // Ondulações de seda inspiradas na calandragem contínua
        float wave1 = snoise(uv * 3.5 + vec2(uTime * 0.15, uTime * 0.08) + mouseEffect);
        float wave2 = snoise(uv * 7.0 - vec2(uTime * 0.22, wave1 * 0.3));
        float waves = (wave1 * 0.65 + wave2 * 0.35);

        // Cores da Stampaholics: Petróleo profundo (#142830), Rosa (#EB2C65) e Esmeralda (#1FB380)
        vec3 cDarkPetrol = vec3(0.05, 0.11, 0.14);
        vec3 cEmerald    = vec3(0.12, 0.70, 0.50);
        vec3 cPink       = vec3(0.92, 0.17, 0.40);

        vec3 col = mix(cDarkPetrol, cEmerald, smoothstep(-0.4, 0.6, waves) * 0.35);
        col = mix(col, cPink, smoothstep(0.3, 0.95, waves) * 0.4);

        // Brilho acetinado de tecido (Silk sheen specular)
        float sheen = pow(max(0.0, waves + 0.3), 3.0) * 0.45;
        col += vec3(sheen * 0.8, sheen * 0.6, sheen * 0.7);

        gl_FragColor = vec4(col, 0.9);
      }
    `;

    const uniforms = {
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector2(0.5, 0.5) },
      uResolution: { value: new THREE.Vector2(wrap.clientWidth, wrap.clientHeight) }
    };

    const mat = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      transparent: true
    });

    const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), mat);
    scene.add(mesh);

    window.addEventListener('mousemove', (e) => {
      uniforms.uMouse.value.x = e.clientX / window.innerWidth;
      uniforms.uMouse.value.y = 1.0 - (e.clientY / window.innerHeight);
    });

    window.addEventListener('resize', () => {
      if (!wrap) return;
      const nw = wrap.clientWidth;
      const nh = wrap.clientHeight;
      renderer.setSize(nw, nh);
      uniforms.uResolution.value.set(nw, nh);
    });

    let clock = new THREE.Clock();

    function render() {
      requestAnimationFrame(render);
      uniforms.uTime.value = clock.getElapsedTime();
      renderer.render(scene, camera);
    }
    render();
  }
</script>
