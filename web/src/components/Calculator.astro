---
---

<section class="boutique-calc-section" id="calculadora">
  <div class="container">
    <div class="calc-box">
      <div class="calc-header-clean">
        <span class="eyebrow" data-i18n-pt="Calculadora Oficial" data-i18n-en="Official Price Simulator">Calculadora Oficial</span>
        <h2 class="calc-headline" data-i18n-pt="Simulador de Preços & Escala" data-i18n-en="Price & Scale Simulator">Simulador de Preços & Escala</h2>
        <p class="calc-sub" data-i18n-pt="Consulte estimativas em tempo real conectadas diretamente à tabela industrial da fábrica." data-i18n-en="Real-time estimates directly connected to official factory price sheets.">
          Consulte estimativas em tempo real conectadas diretamente à tabela industrial da fábrica.
        </p>
      </div>

      <!-- 3 Abas Sóbrias de Serviços -->
      <div class="calc-tabs">
        <button class="tab-btn active" data-tab="tecido" data-i18n-pt="Tecido por Metro" data-i18n-en="Fabric by Meter">Tecido por Metro</button>
        <button class="tab-btn" data-tab="corte-laser" data-i18n-pt="Corte a Laser" data-i18n-en="Laser Cutting">Corte a Laser</button>
        <button class="tab-btn" data-tab="produto" data-i18n-pt="Produtos Prontos" data-i18n-en="Finished Products">Produtos Prontos</button>
      </div>

      <div class="calc-body-grid">
        <!-- Controles de Entrada -->
        <div class="calc-inputs">
          <div class="calc-field">
            <label id="item-select-label" data-i18n-pt="Selecione a Base ou Produto:" data-i18n-en="Select Base or Product:">Selecione a Base ou Produto:</label>
            <select id="calc-item-select" class="clean-select"></select>
          </div>

          <!-- Metragem ou Peças -->
          <div class="calc-field" id="meters-field">
            <label id="qty-label" data-i18n-pt="Metragem Linear (metros):" data-i18n-en="Linear Meters:">Metragem Linear (metros):</label>
            <div class="input-unit-wrap">
              <input type="number" id="calc-qty-input" min="100" step="10" value="100" />
              <span class="unit-symbol" id="unit-symbol">m</span>
            </div>
            <small class="calc-hint" id="min-hint" data-i18n-pt="Pedido mínimo na tabela: 100m." data-i18n-en="Minimum order on price table: 100m.">Pedido mínimo na tabela: 100m.</small>
          </div>

          <!-- Peças adicionais (apenas para corte laser) -->
          <div class="calc-field" id="laser-pieces-field" style="display: none;">
            <label data-i18n-pt="Quantidade de Peças a Cortar:" data-i18n-en="Number of Pieces to Cut:">Quantidade de Peças a Cortar:</label>
            <div class="input-unit-wrap">
              <input type="number" id="calc-laser-pieces" min="1" step="1" value="100" />
              <span class="unit-symbol">peças</span>
            </div>
            <small class="calc-hint" data-i18n-pt="Para apuração do custo unitário por peça cortada." data-i18n-en="To calculate the unit cost per cut piece.">Para apuração do custo unitário por peça cortada.</small>
          </div>

          <!-- Faixas de Volume Ativas -->
          <div class="calc-tier-indicator">
            <span class="tier-label" data-i18n-pt="Faixas de Escala Industrial:" data-i18n-en="Industrial Volume Tiers:">Faixas de Escala Industrial:</span>
            <div class="tier-pills" id="tier-pills-wrap"></div>
          </div>
        </div>

        <!-- Painel de Valor & Orçamento -->
        <div class="calc-display-panel">
          <div class="display-metric">
            <span class="metric-title" data-i18n-pt="Valor Unitário Estimado" data-i18n-en="Estimated Unit Price">Valor Unitário Estimado</span>
            <div class="metric-number" id="display-unit-val">R$ --</div>
            <div class="metric-detail" id="display-unit-sub"></div>
          </div>

          <div class="display-subtotal">
            <div class="subtotal-row">
              <span data-i18n-pt="Subtotal Estimado:" data-i18n-en="Estimated Subtotal:">Subtotal Estimado:</span>
              <strong id="display-total-val">R$ --</strong>
            </div>
          </div>

          <a href="#" target="_blank" rel="noopener noreferrer" class="btn-boutique-primary calc-cta" id="calc-wa-btn">
            <span data-i18n-pt="Solicitar Este Orçamento no WhatsApp" data-i18n-en="Request This Quote on WhatsApp">Solicitar Este Orçamento no WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .boutique-calc-section {
    padding: 80px 0;
    background: var(--bg-dark-surface);
    border-top: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
  }

  .calc-box {
    background: var(--bg-dark-card);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    padding: 44px;
  }

  .calc-header-clean {
    max-width: 600px;
    margin-bottom: 32px;
  }

  .calc-headline {
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 8px;
  }

  .calc-sub {
    font-size: 15px;
    color: var(--text-white-muted);
  }

  .calc-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border-dark);
    padding-bottom: 16px;
    overflow-x: auto;
  }

  .tab-btn {
    font-family: var(--font-heading);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-white-muted);
    padding: 8px 18px;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .tab-btn:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-btn.active {
    background: var(--brand-pink);
    color: #FFFFFF;
    box-shadow: 0 2px 14px var(--brand-pink-glow);
  }

  .calc-body-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: start;
  }

  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .calc-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .calc-field label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: #E2E8F0;
  }

  .clean-select {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-dark);
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 14.5px;
    outline: none;
    transition: border-color 0.2s;
  }

  .clean-select:focus {
    border-color: var(--brand-pink);
  }

  .input-unit-wrap {
    position: relative;
    display: flex;
  }

  .input-unit-wrap input {
    width: 100%;
    padding: 11px 64px 11px 14px;
    border-radius: var(--radius-sm);
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-dark);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
    outline: none;
    transition: border-color 0.2s;
  }

  .input-unit-wrap input:focus {
    border-color: var(--brand-pink);
  }

  .unit-symbol {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-white-muted);
    pointer-events: none;
  }

  .calc-hint {
    font-size: 11.5px;
    color: var(--text-white-muted);
  }

  .calc-tier-indicator {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    padding: 14px;
    margin-top: 6px;
  }

  .tier-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--brand-green);
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .tier-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tier-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-white-muted);
    border: 1px solid transparent;
  }

  .tier-pill.active {
    background: var(--brand-green);
    color: #0D191E;
    font-weight: 700;
  }

  /* Display Panel */
  .calc-display-panel {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .display-metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-bottom: 1px solid var(--border-dark);
    padding-bottom: 20px;
  }

  .metric-title {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--text-white-muted);
    letter-spacing: 0.04em;
  }

  .metric-number {
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 700;
    color: var(--brand-green);
    line-height: 1.1;
  }

  .metric-detail {
    font-size: 12.5px;
    color: var(--text-white-muted);
  }

  .subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 15px;
  }

  .subtotal-row strong {
    font-family: var(--font-mono);
    font-size: 24px;
    color: #FFFFFF;
  }

  .calc-cta {
    width: 100%;
    margin-top: 8px;
  }

  @media (max-width: 860px) {
    .calc-box {
      padding: 24px;
    }
    .calc-body-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import calcData from '../data/calculatorData.json';

  let currentCategory = 'tecido';
  let activeTierIdx = 0;
  let selectedItem: any = null;

  const tabBtns = document.querySelectorAll('.tab-btn');
  const selectEl = document.getElementById('calc-item-select') as HTMLSelectElement | null;
  const qtyInput = document.getElementById('calc-qty-input') as HTMLInputElement | null;
  const laserPiecesInput = document.getElementById('calc-laser-pieces') as HTMLInputElement | null;
  const laserPiecesField = document.getElementById('laser-pieces-field');
  const unitSymbol = document.getElementById('unit-symbol');
  const qtyLabel = document.getElementById('qty-label');
  const minHint = document.getElementById('min-hint');
  const tierPillsWrap = document.getElementById('tier-pills-wrap');

  const displayUnitVal = document.getElementById('display-unit-val');
  const displayUnitSub = document.getElementById('display-unit-sub');
  const displayTotalVal = document.getElementById('display-total-val');
  const waBtn = document.getElementById('calc-wa-btn') as HTMLAnchorElement | null;

  function fmtBRL(val: number) {
    return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }

  function renderTierPills() {
    if (!tierPillsWrap) return;
    tierPillsWrap.innerHTML = '';
    calcData.faixas.forEach((f, idx) => {
      const p = document.createElement('span');
      p.className = `tier-pill ${idx === activeTierIdx ? 'active' : ''}`;
      p.textContent = f.label;
      tierPillsWrap.appendChild(p);
    });
  }

  function getTierIndex(qty: number) {
    for (let i = 0; i < calcData.faixas.length; i++) {
      const f = calcData.faixas[i];
      if (qty >= f.minimo && (f.maximo === null || qty <= f.maximo)) return i;
    }
    return calcData.faixas.length - 1;
  }

  function populateSelect() {
    if (!selectEl) return;
    selectEl.innerHTML = '';

    const items = calcData.produtos.filter((p) => p.categoria === currentCategory);

    items.forEach((it) => {
      const opt = document.createElement('option');
      opt.value = it.sku;
      opt.textContent = it.nome;
      selectEl.appendChild(opt);
    });

    selectedItem = items[0] || null;
    updateCategoryControls();
    recalc();
  }

  function updateCategoryControls() {
    if (!qtyLabel || !unitSymbol || !minHint || !laserPiecesField) return;

    if (currentCategory === 'tecido') {
      qtyLabel.textContent = 'Metragem Linear (metros):';
      unitSymbol.textContent = 'metros';
      minHint.textContent = 'Pedido mínimo na tabela: 100m.';
      laserPiecesField.style.display = 'none';
      if (qtyInput) qtyInput.value = '100';
    } else if (currentCategory === 'corte-laser') {
      qtyLabel.textContent = 'Metragem Total Consumida (m):';
      unitSymbol.textContent = 'metros';
      minHint.textContent = 'Cálculo por consumo em metros para corte a laser.';
      laserPiecesField.style.display = 'flex';
      if (qtyInput) qtyInput.value = '100';
    } else {
      // Produto Pronto
      qtyLabel.textContent = 'Quantidade de Peças:';
      unitSymbol.textContent = 'unidades';
      minHint.textContent = 'Tabela de preços por escala de tiragem.';
      laserPiecesField.style.display = 'none';
      if (qtyInput) qtyInput.value = '50';
    }
  }

  function recalc() {
    if (!selectedItem || !qtyInput) return;

    const qty = parseFloat(qtyInput.value) || 0;
    activeTierIdx = getTierIndex(qty);
    renderTierPills();

    const prices = selectedItem.precos;
    const price = prices[activeTierIdx] || prices[prices.length - 1];

    if (currentCategory === 'corte-laser') {
      const pieces = laserPiecesInput ? parseFloat(laserPiecesInput.value) || 1 : 1;
      const subtotal = qty * price;
      const piecePrice = subtotal / pieces;

      if (displayUnitVal) displayUnitVal.textContent = fmtBRL(piecePrice) + ' / peça';
      if (displayUnitSub) displayUnitSub.textContent = `Consumo: ${qty}m (${fmtBRL(price)}/m) para ${pieces} peças`;
      if (displayTotalVal) displayTotalVal.textContent = fmtBRL(subtotal);

      if (waBtn) {
        const text = encodeURIComponent(`Olá, Stampaholics! Gostaria de um orçamento para: ${selectedItem.nome}\n• Metragem: ${qty}m\n• Peças: ${pieces}\n• Estimativa calculada: ${fmtBRL(subtotal)}`);
        waBtn.href = `https://wa.me/5511999999999?text=${text}`;
      }
    } else if (currentCategory === 'tecido') {
      const subtotal = qty * price;
      if (displayUnitVal) displayUnitVal.textContent = fmtBRL(price) + ' / metro';
      if (displayUnitSub) displayUnitSub.textContent = `Faixa de escala: ${calcData.faixas[activeTierIdx].label}m`;
      if (displayTotalVal) displayTotalVal.textContent = fmtBRL(subtotal);

      if (waBtn) {
        const text = encodeURIComponent(`Olá, Stampaholics! Gostaria de um orçamento para: ${selectedItem.nome}\n• Quantidade: ${qty} metros\n• Estimativa: ${fmtBRL(subtotal)}`);
        waBtn.href = `https://wa.me/5511999999999?text=${text}`;
      }
    } else {
      // Produto Pronto
      const subtotal = qty * price;
      if (displayUnitVal) displayUnitVal.textContent = fmtBRL(price) + ' / un.';
      if (displayUnitSub) displayUnitSub.textContent = `Tiragem de escala: ${qty} peças`;
      if (displayTotalVal) displayTotalVal.textContent = fmtBRL(subtotal);

      if (waBtn) {
        const text = encodeURIComponent(`Olá, Stampaholics! Gostaria de um orçamento para: ${selectedItem.nome}\n• Quantidade: ${qty} peças\n• Estimativa: ${fmtBRL(subtotal)}`);
        waBtn.href = `https://wa.me/5511999999999?text=${text}`;
      }
    }
  }

  // Abas
  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentCategory = btn.getAttribute('data-tab') || 'tecido';
      populateSelect();
    });
  });

  if (selectEl) {
    selectEl.addEventListener('change', () => {
      const sku = selectEl.value;
      selectedItem = calcData.produtos.find((p) => p.sku === sku) || null;
      recalc();
    });
  }

  if (qtyInput) qtyInput.addEventListener('input', recalc);
  if (laserPiecesInput) laserPiecesInput.addEventListener('input', recalc);

  populateSelect();
</script>
