---
---

<div class="boutique-drawer-overlay" id="product-drawer-overlay">
  <div class="boutique-drawer-panel" id="product-drawer-panel">
    <button class="drawer-close-btn" id="drawer-close-btn" aria-label="Fechar">✕</button>

    <div class="drawer-scroll">
      <!-- Imagem do Produto Flutuante em Fundo Neutro Limpo -->
      <div class="drawer-stage product-contact-shadow">
        <img src="" alt="" id="drawer-img" class="drawer-img" />
      </div>

      <div class="drawer-content">
        <div class="drawer-meta-tag" id="drawer-cat"></div>
        <h2 class="drawer-name" id="drawer-name"></h2>
        <p class="drawer-desc" id="drawer-desc"></p>

        <!-- Especificações -->
        <div class="drawer-spec-table">
          <div class="spec-item">
            <span class="spec-k" data-i18n-pt="Tecido Base" data-i18n-en="Base Fabric">Tecido Base</span>
            <span class="spec-v" id="drawer-fabric"></span>
          </div>
          <div class="spec-item">
            <span class="spec-k" data-i18n-pt="Pedido Mínimo" data-i18n-en="Minimum Order">Pedido Mínimo</span>
            <span class="spec-v" id="drawer-min"></span>
          </div>
          <div class="spec-item">
            <span class="spec-k" data-i18n-pt="Acabamento & Corte" data-i18n-en="Finishing & Cut">Acabamento & Corte</span>
            <span class="spec-v" id="drawer-finish"></span>
          </div>
        </div>

        <!-- Calculadora de Orçamento no Drawer -->
        <div class="drawer-calc-box">
          <h4 class="calc-box-title font-intheknow" data-i18n-pt="simular quantidade & variante" data-i18n-en="simulate quantity & size">simular quantidade & variante</h4>
          
          <div class="drawer-calc-fields">
            <div class="drawer-calc-group">
              <label for="drawer-variant-select" data-i18n-pt="Tamanho / Variante:" data-i18n-en="Size / Variant:">Tamanho / Variante:</label>
              <select id="drawer-variant-select" class="drawer-calc-select"></select>
            </div>

            <div class="drawer-calc-group">
              <label for="drawer-qty-input" data-i18n-pt="Quantidade de Peças:" data-i18n-en="Quantity (pieces):">Quantidade de Peças:</label>
              <input type="number" id="drawer-qty-input" class="drawer-calc-input" min="20" step="10" value="50" />
            </div>
          </div>

          <div class="drawer-calc-result">
            <div class="drawer-subtotal-line">
              <span data-i18n-pt="Faixa Estimada:" data-i18n-en="Estimated Tier:">Faixa Estimada:</span>
              <strong id="drawer-calc-price">Consulte sob volume</strong>
            </div>
          </div>
        </div>

        <!-- Diferenciais -->
        <div class="drawer-chips" id="drawer-chips"></div>

        <!-- Ação Direta de Orçamento -->
        <div class="drawer-action-box">
          <a href="#" target="_blank" rel="noopener noreferrer" class="btn-boutique-primary drawer-wa-btn" id="drawer-wa-link">
            <span data-i18n-pt="Solicitar Orçamento no WhatsApp" data-i18n-en="Request Quote on WhatsApp">Solicitar Orçamento no WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .boutique-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(11, 23, 28, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .boutique-drawer-overlay.active {
    display: block;
    opacity: 1;
  }

  .boutique-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 500px;
    background: var(--bg-dark-surface);
    border-left: 1px solid var(--border-dark);
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.45);
    transform: translateX(100%);
    transition: transform 0.35s var(--ease-boutique);
    display: flex;
    flex-direction: column;
  }

  .boutique-drawer-overlay.active .boutique-drawer-panel {
    transform: translateX(0%);
  }

  .drawer-close-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background 0.2s;
  }

  .drawer-close-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .drawer-scroll {
    overflow-y: auto;
    padding: 32px 28px;
    flex-grow: 1;
  }

  .drawer-stage {
    width: 100%;
    height: 240px;
    background: #FFFFFF;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    margin-bottom: 24px;
  }

  .drawer-img {
    max-height: 200px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.15));
  }

  .drawer-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .drawer-meta-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-pink);
  }

  .drawer-name {
    font-size: 24px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.15;
  }

  .drawer-desc {
    font-size: 14px;
    color: var(--text-white-muted);
    line-height: 1.6;
  }

  .drawer-spec-table {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-k {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-green);
  }

  .spec-v {
    font-size: 13.5px;
    color: #E2E8F0;
    font-weight: 500;
  }

  /* Calculadora Embutida no Drawer */
  .drawer-calc-box {
    background: var(--bg-dark-card);
    border: 1px solid rgba(235, 44, 101, 0.3);
    border-radius: var(--radius-md);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 4px;
  }

  .calc-box-title {
    font-size: 18px;
    color: #FFFFFF;
    letter-spacing: 0.04em;
  }

  .drawer-calc-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .drawer-calc-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .drawer-calc-group label {
    font-size: 12px;
    color: var(--text-white-muted);
  }

  .drawer-calc-select,
  .drawer-calc-input {
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    background: var(--bg-dark-surface);
    border: 1px solid var(--border-dark);
    color: #FFFFFF;
    font-size: 13.5px;
    font-family: var(--font-body);
    outline: none;
  }

  .drawer-calc-select:focus,
  .drawer-calc-input:focus {
    border-color: var(--brand-pink);
  }

  .drawer-calc-result {
    padding-top: 8px;
    border-top: 1px solid var(--border-dark);
  }

  .drawer-subtotal-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13.5px;
  }

  .drawer-subtotal-line strong {
    font-family: var(--font-mono);
    color: var(--brand-green);
    font-size: 15px;
  }

  .drawer-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .boutique-chip {
    font-size: 11px;
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-white-muted);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .drawer-action-box {
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border-dark);
  }

  .drawer-wa-btn {
    width: 100%;
    padding: 13px;
    font-size: 14px;
  }
</style>

<script>
  import products from '../data/products.json';

  const overlay = document.getElementById('product-drawer-overlay');
  const closeBtn = document.getElementById('drawer-close-btn');

  const drawerImg = document.getElementById('drawer-img') as HTMLImageElement | null;
  const drawerName = document.getElementById('drawer-name');
  const drawerDesc = document.getElementById('drawer-desc');
  const drawerCat = document.getElementById('drawer-cat');
  const drawerFabric = document.getElementById('drawer-fabric');
  const drawerMin = document.getElementById('drawer-min');
  const drawerFinish = document.getElementById('drawer-finish');
  const drawerChips = document.getElementById('drawer-chips');

  const variantSelect = document.getElementById('drawer-variant-select') as HTMLSelectElement | null;
  const qtyInput = document.getElementById('drawer-qty-input') as HTMLInputElement | null;
  const calcPriceTxt = document.getElementById('drawer-calc-price');
  const drawerWaLink = document.getElementById('drawer-wa-link') as HTMLAnchorElement | null;

  let currentProduct: any = null;

  function updateDrawerQuote() {
    if (!currentProduct || !drawerWaLink) return;

    const variant = variantSelect ? variantSelect.value : 'Padrão';
    const qty = qtyInput ? qtyInput.value : '50';

    if (calcPriceTxt) {
      calcPriceTxt.textContent = `${qty} peças · ${variant}`;
    }

    const msg = encodeURIComponent(`Olá, Stampaholics! Gostaria de um orçamento para:\n• Produto: ${currentProduct.name}\n• Variante/Tamanho: ${variant}\n• Quantidade Estimada: ${qty} peças\n• Tecido: ${currentProduct.fabric}`);
    drawerWaLink.href = `https://wa.me/5511999999999?text=${msg}`;
  }

  function openDrawer(productId: string) {
    const product = products.find((p) => p.id === productId);
    if (!product || !overlay) return;

    currentProduct = product;
    const lang = localStorage.getItem('stampaholics_lang') || 'pt';
    const isEn = lang === 'en';

    if (drawerImg) {
      drawerImg.src = product.image;
      drawerImg.alt = product.name;
    }

    if (drawerName) drawerName.textContent = isEn && product.name_en ? product.name_en : product.name;
    if (drawerDesc) drawerDesc.textContent = isEn && product.description_en ? product.description_en : product.description;
    if (drawerCat) drawerCat.textContent = product.category;
    if (drawerFabric) drawerFabric.textContent = product.fabric;
    if (drawerMin) drawerMin.textContent = product.minOrder;
    if (drawerFinish) drawerFinish.textContent = product.finish;

    // Popula variantes/tamanhos
    if (variantSelect) {
      variantSelect.innerHTML = '';
      const sizeItems = product.sizes.split(',').map((s) => s.trim());
      sizeItems.forEach((sz) => {
        const opt = document.createElement('option');
        opt.value = sz;
        opt.textContent = sz;
        variantSelect.appendChild(opt);
      });
    }

    if (qtyInput) {
      const match = product.minOrder.match(/\d+/);
      qtyInput.value = match ? match[0] : '50';
    }

    if (drawerChips) {
      drawerChips.innerHTML = '';
      product.highlights.forEach((hl) => {
        const span = document.createElement('span');
        span.className = 'boutique-chip';
        span.textContent = hl;
        drawerChips.appendChild(span);
      });
    }

    updateDrawerQuote();
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!overlay) return;
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeDrawer();
    });
  }

  if (variantSelect) variantSelect.addEventListener('change', updateDrawerQuote);
  if (qtyInput) qtyInput.addEventListener('input', updateDrawerQuote);

  window.addEventListener('stampaholics:open-drawer', ((e: CustomEvent<{ id: string }>) => {
    openDrawer(e.detail.id);
  }) as EventListener);
</script>
