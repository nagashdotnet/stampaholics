---
import products from '../data/products.json';
---

<section class="catalog-section" id="catalogo">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-petrol">Catálogo de Produtos</div>
      <h2 class="section-title">Soluções em Tecido Sob Medida</h2>
      <p class="section-subtitle">
        Selecione uma categoria para explorar os mockups, conferir as especificações de cada tecido e adicionar itens ao seu orçamento.
      </p>
    </div>

    <!-- Filtros e Busca -->
    <div class="catalog-controls">
      <div class="filter-pills" id="filter-pills">
        <button class="filter-btn active" data-filter="all">Todos ({products.length})</button>
        <button class="filter-btn" data-filter="esportes">🏃‍♂️ Esportes & Corrida</button>
        <button class="filter-btn" data-filter="eventos">🎪 Eventos & Festas</button>
        <button class="filter-btn" data-filter="corporativo">🏢 Corporativo & Brindes</button>
        <button class="filter-btn" data-filter="decoracao">🛋️ Decoração & Cenografia</button>
        <button class="filter-btn" data-filter="moda">🌴 Moda & Lifestyle</button>
        <button class="filter-btn" data-filter="pdv">🚩 Banners & PDV</button>
      </div>

      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="catalog-search" placeholder="Buscar produto ou tecido..." />
      </div>
    </div>

    <!-- Grid de Produtos -->
    <div class="products-grid" id="products-grid">
      {products.map((product) => (
        <article 
          class="product-card" 
          data-category={product.category}
          data-id={product.id}
          data-name={product.name.toLowerCase()}
          data-fabric={product.fabric.toLowerCase()}
        >
          <div class="product-top-bar">
            <span class="product-cat-tag">{product.categoryName}</span>
            <span class="product-min-tag">Mín: {product.minOrder}</span>
          </div>

          <!-- Imagem Recortada Flutuante com Sombra de Contato -->
          <div class="product-img-wrapper product-contact-shadow open-details-btn" data-id={product.id} title="Clique para ver detalhes">
            <img 
              src={product.image} 
              alt={product.name} 
              class="product-img" 
              loading="lazy" 
            />
          </div>

          <div class="product-info">
            <h3 class="product-title open-details-btn" data-id={product.id}>{product.name}</h3>
            <p class="product-desc">{product.description}</p>
            
            <div class="product-meta">
              <div class="meta-item">
                <span class="meta-label">Tecido Base:</span>
                <span class="meta-val">{product.fabric}</span>
              </div>
            </div>

            <div class="product-highlights">
              {product.highlights.slice(0, 3).map((hl) => (
                <span class="highlight-chip">{hl}</span>
              ))}
            </div>

            <div class="product-actions">
              <button class="btn-details open-details-btn" data-id={product.id}>
                <span>Especificações</span>
              </button>
              <button 
                class="btn-add-quote add-to-quote-btn" 
                data-id={product.id}
                data-name={product.name}
                data-fabric={product.fabric}
                data-image={product.image}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Orçar</span>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Estado Vazio para Busca -->
    <div class="empty-results" id="empty-results" style="display: none;">
      <p>Nenhum produto encontrado com esse termo. Tente buscar por "Dry-Fit", "Abadá" ou "Bolsa".</p>
    </div>
  </div>
</section>

<style>
  .catalog-section {
    padding: 80px 0;
    background: var(--bg-page);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  .section-title {
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 800;
    color: var(--brand-petrol-dark);
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .section-subtitle {
    font-size: 16px;
    color: var(--text-muted);
  }

  /* Controles: Filtros e Busca */
  .catalog-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter-btn {
    font-family: var(--font-heading);
    font-size: 13.5px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: #FFFFFF;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background: var(--bg-subtle);
    color: var(--brand-petrol);
    border-color: #CBD5E1;
  }

  .filter-btn.active {
    background: var(--brand-petrol);
    color: #FFFFFF;
    border-color: var(--brand-petrol);
    box-shadow: 0 4px 12px rgba(39, 77, 94, 0.25);
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 260px;
  }

  .search-box svg {
    position: absolute;
    left: 14px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    padding: 10px 14px 10px 40px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: #FFFFFF;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-main);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-box input:focus {
    border-color: var(--brand-green);
    box-shadow: 0 0 0 3px rgba(31, 179, 128, 0.15);
  }

  /* Grid de Cards */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 28px;
  }

  .product-card {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(226, 232, 240, 0.9);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.28s var(--ease-spring), box-shadow 0.28s var(--ease-spring), border-color 0.28s;
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-ambient);
    border-color: rgba(31, 179, 128, 0.4);
  }

  .product-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .product-cat-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-green-dark);
  }

  .product-min-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* Palco do Produto PNG Recortado */
  .product-img-wrapper {
    width: 100%;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    cursor: pointer;
    overflow: hidden;
  }

  .product-img {
    max-height: 190px;
    width: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
    filter: drop-shadow(0 10px 18px rgba(13, 29, 35, 0.12));
  }

  .product-card:hover .product-img {
    transform: scale(1.05);
  }

  .product-info {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--brand-petrol-dark);
    margin-bottom: 6px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .product-title:hover {
    color: var(--brand-green-dark);
  }

  .product-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-meta {
    font-size: 12px;
    background: var(--bg-subtle);
    padding: 8px 10px;
    border-radius: 6px;
    margin-bottom: 12px;
  }

  .meta-label {
    color: var(--text-muted);
    margin-right: 4px;
  }

  .meta-val {
    font-weight: 600;
    color: var(--brand-petrol);
  }

  .product-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .highlight-chip {
    font-size: 10.5px;
    font-weight: 500;
    background: rgba(31, 179, 128, 0.08);
    color: var(--brand-green-dark);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .product-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--border-subtle);
  }

  .btn-details {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-petrol);
    background: var(--bg-subtle);
    border: 1px solid transparent;
    transition: all 0.2s;
  }

  .btn-details:hover {
    background: #E2E8F0;
    color: var(--brand-petrol-dark);
  }

  .btn-add-quote {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 700;
    background: var(--brand-pink);
    color: #FFFFFF;
    box-shadow: 0 2px 8px var(--brand-pink-glow);
    transition: all 0.2s;
  }

  .btn-add-quote:hover {
    background: var(--brand-pink-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(235, 44, 101, 0.35);
  }

  .empty-results {
    text-align: center;
    padding: 60px 20px;
    font-size: 16px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .catalog-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-pills {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 8px;
    }

    .filter-btn {
      white-space: nowrap;
    }

    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Script interativo de filtros e busca
  const filterBtns = document.querySelectorAll('.filter-btn');
  const productCards = document.querySelectorAll('.product-card');
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
  const emptyResults = document.getElementById('empty-results');

  let currentCategory = 'all';
  let searchTerm = '';

  function applyFilters() {
    let visibleCount = 0;

    productCards.forEach((card) => {
      const el = card as HTMLElement;
      const cat = el.getAttribute('data-category');
      const name = el.getAttribute('data-name') || '';
      const fabric = el.getAttribute('data-fabric') || '';

      const matchCategory = (currentCategory === 'all' || cat === currentCategory);
      const matchSearch = (!searchTerm || name.includes(searchTerm) || fabric.includes(searchTerm));

      if (matchCategory && matchSearch) {
        el.style.display = 'flex';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (emptyResults) {
      emptyResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentCategory = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });
  }
</script>
