---
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-tag">
        <span class="pulse-dot"></span>
        <span>Estúdio de Sublimação & Corte Laser Têxtil</span>
      </div>

      <h1 class="hero-title">
        Impressão Digital em Tecido de <span class="highlight-text">Alta Definição</span> para Grandes Volumes e Eventos.
      </h1>

      <p class="hero-description">
        Sublimação total com fidelidade de cores incomparável, preto profundo e toque zero. 
        Produzimos abadás, kits de corrida, vestuário esportivo, comunicação visual e brindes corporativos com acabamento profissional a laser.
      </p>

      <div class="hero-actions">
        <a href="#catalogo" class="btn-primary">
          <span>Explorar Catálogo</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="#calculadora" class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <line x1="16" y1="14" x2="16" y2="18"></line>
            <path d="M16 10h.01"></path>
            <path d="M12 10h.01"></path>
            <path d="M8 10h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M8 14h.01"></path>
            <path d="M12 18h.01"></path>
            <path d="M8 18h.01"></path>
          </svg>
          <span>Calculadora de Preços</span>
        </a>
      </div>

      <!-- Métricas Industriais -->
      <div class="hero-metrics">
        <div class="metric-item">
          <span class="metric-val">100%</span>
          <span class="metric-desc">Digital Toque Zero</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-val">Laser</span>
          <span class="metric-desc">Corte Sem Desfiar</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-val">+16</span>
          <span class="metric-desc">Tecidos Tecnológicos</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <span class="metric-val">Brasil</span>
          <span class="metric-desc">Envio para todo o país</span>
        </div>
      </div>
    </div>

    <!-- Composição Visual de Destaque -->
    <div class="hero-visual">
      <div class="hero-image-stage">
        <!-- Badge Flutuante 1 -->
        <div class="floating-badge top-badge">
          <div class="badge-icon">✓</div>
          <div>
            <strong>Dry-Fit UV50+</strong>
            <small>Respirabilidade Total</small>
          </div>
        </div>

        <!-- Imagem Principal Central -->
        <div class="hero-main-product product-contact-shadow">
          <img src="/products/Kit_Corrida_DryFit_Sacochila.png" alt="Kit Corrida e Sacochila Sublimada" class="hero-img-front" />
        </div>

        <!-- Produto Secundário Flutuante -->
        <div class="hero-sub-product product-contact-shadow">
          <img src="/products/Abadas_Festa.png" alt="Abadá de Festa Personalizado" class="hero-img-back" />
        </div>

        <!-- Badge Flutuante 2 -->
        <div class="floating-badge bottom-badge">
          <div class="badge-icon green">⚡</div>
          <div>
            <strong>Pronto para Produção</strong>
            <small>Até 10.000 peças/semana</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 130px;
    padding-bottom: 70px;
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(31, 179, 128, 0.08) 0%, rgba(255,255,255,0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    background: rgba(39, 77, 94, 0.08);
    color: var(--brand-petrol);
    font-size: 13px;
    font-weight: 600;
    width: fit-content;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 0 0 rgba(31, 179, 128, 0.7);
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0% { box-shadow: 0 0 0 0 rgba(31, 179, 128, 0.7); }
    70% { box-shadow: 0 0 0 8px rgba(31, 179, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(31, 179, 128, 0); }
  }

  .hero-title {
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--brand-petrol-dark);
    letter-spacing: -0.03em;
  }

  .highlight-text {
    background: linear-gradient(135deg, var(--brand-green-dark) 0%, var(--brand-green) 50%, var(--brand-petrol) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }

  .hero-metrics {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 24px;
    margin-top: 10px;
    border-top: 1px solid var(--border-subtle);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 20px;
    color: var(--brand-petrol);
    line-height: 1.1;
  }

  .metric-desc {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .metric-divider {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
  }

  /* Estágio Visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image-stage {
    position: relative;
    width: 100%;
    max-width: 460px;
    height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-main-product {
    position: relative;
    z-index: 3;
    width: 82%;
    transition: transform 0.4s ease;
  }

  .hero-main-product img {
    width: 100%;
    filter: drop-shadow(0 18px 30px rgba(13, 29, 35, 0.16));
    animation: floatSmooth 5s ease-in-out infinite;
  }

  .hero-sub-product {
    position: absolute;
    top: -15px;
    right: -20px;
    width: 58%;
    z-index: 2;
    opacity: 0.92;
  }

  .hero-sub-product img {
    width: 100%;
    filter: drop-shadow(0 14px 24px rgba(13, 29, 35, 0.12));
    animation: floatSmooth 6s ease-in-out infinite reverse;
  }

  @keyframes floatSmooth {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .floating-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #FFFFFF;
    padding: 10px 16px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(226, 232, 240, 0.8);
    z-index: 4;
  }

  .top-badge {
    top: 20px;
    left: -20px;
  }

  .bottom-badge {
    bottom: 20px;
    right: 0px;
  }

  .badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(39, 77, 94, 0.1);
    color: var(--brand-petrol);
    font-weight: 700;
    font-size: 13px;
  }

  .badge-icon.green {
    background: rgba(31, 179, 128, 0.15);
    color: var(--brand-green-dark);
  }

  .floating-badge strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--brand-petrol-dark);
    line-height: 1.2;
  }

  .floating-badge small {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-tag {
      margin: 0 auto;
    }

    .hero-description {
      margin: 0 auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-metrics {
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-image-stage {
      margin: 20px auto 0;
      max-width: 380px;
      height: 380px;
    }

    .top-badge {
      left: 0;
    }
    .bottom-badge {
      right: 0;
    }
  }
</style>
