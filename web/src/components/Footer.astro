---
import HeartLogo3D from './HeartLogo3D.astro';
---

<footer class="boutique-footer">
  <div class="container footer-central-layout">
    <!-- Coluna Esquerda: Marca & Copyright -->
    <div class="footer-side left-side">
      <span class="footer-title font-intheknow">stampaholics</span>
      <p class="footer-desc" data-i18n-pt="Estúdio de impressão digital têxtil por sublimação contínua e corte óptico a laser para eventos, moda e grandes marcas." data-i18n-en="Continuous sublimation textile printing studio and optical laser cutting for events, fashion, and brands.">
        Estúdio de impressão digital têxtil por sublimação contínua e corte óptico a laser para eventos, moda e grandes marcas.
      </p>
      <div class="footer-legal">
        <p>© {new Date().getFullYear()} Stampaholics Têxtil Ltda.</p>
        <span>São Paulo - SP · Brasil</span>
      </div>
    </div>

    <!-- Centro: Coração 3D Geométrico Oficial com Movimento do Mouse -->
    <div class="footer-center-3d">
      <HeartLogo3D size={180} />
      <span class="footer-3d-caption font-intheknow">pure textile passion</span>
    </div>

    <!-- Coluna Direita: Suporte, FAQ, Contato & Redes -->
    <div class="footer-side right-side">
      <h4 class="footer-side-title font-intheknow" data-i18n-pt="canais & suporte" data-i18n-en="support & channels">canais & suporte</h4>
      <ul class="footer-links-clean">
        <li><a href="/faq" data-i18n-pt="Dúvidas Frequentes (FAQ)" data-i18n-en="Frequently Asked Questions (FAQ)">Dúvidas Frequentes (FAQ)</a></li>
        <li><a href="/contato" data-i18n-pt="Formulário de Contato" data-i18n-en="Direct Contact Form">Formulário de Contato</a></li>
        <li><a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer">WhatsApp Comercial</a></li>
        <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram @stampaholics</a></li>
      </ul>
      <div class="footer-seal">
        <span class="seal-dot"></span>
        <span class="seal-text">Sublimação 100% Digital & Laser Cut</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .boutique-footer {
    background: #0B161B;
    border-top: 1px solid var(--border-dark);
    padding: 70px 0 50px;
    color: var(--text-white-muted);
    position: relative;
    overflow: hidden;
  }

  .footer-central-layout {
    display: grid;
    grid-template-columns: 1fr 220px 1fr;
    gap: 48px;
    align-items: center;
  }

  .footer-side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .left-side {
    text-align: left;
  }

  .right-side {
    text-align: right;
    align-items: flex-end;
  }

  .footer-title {
    font-size: 32px;
    color: #FFFFFF;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .footer-desc {
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 360px;
    color: var(--text-white-muted);
  }

  .footer-legal {
    font-size: 12px;
    color: #64748B;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 6px;
  }

  /* Centro 3D */
  .footer-center-3d {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .footer-3d-caption {
    font-size: 16px;
    color: var(--brand-pink);
    letter-spacing: 0.06em;
    margin-top: -6px;
    opacity: 0.85;
  }

  .footer-side-title {
    font-size: 20px;
    color: #FFFFFF;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .footer-links-clean {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links-clean li {
    list-style: none !important;
  }

  .footer-links-clean a {
    font-size: 13.5px;
    color: #94A3B8;
    transition: color 0.2s;
  }

  .footer-links-clean a:hover {
    color: var(--brand-pink);
  }

  .footer-seal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--brand-green);
    margin-top: 10px;
  }

  .seal-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-green);
  }

  @media (max-width: 900px) {
    .footer-central-layout {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 36px;
    }

    .left-side, .right-side {
      text-align: center;
      align-items: center;
    }

    .footer-desc {
      margin: 0 auto;
    }
  }
</style>
