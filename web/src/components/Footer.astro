<footer class="boutique-footer">
  <div class="container footer-grid">
    <div class="footer-brand-pane">
      <div class="footer-brand-logo">
        <img src="/brand/stampaholics_icon.png" alt="Stampaholics" class="footer-heart" />
        <span class="footer-brand-title">stampaholics</span>
      </div>
      <p class="footer-tagline" data-i18n-pt="Estúdio de impressão digital têxtil por sublimação e corte a laser para eventos, moda e grandes marcas." data-i18n-en="Digital textile sublimation studio and laser cutting for events, fashion, and enterprise brands.">
        Estúdio de impressão digital têxtil por sublimação e corte a laser para eventos, moda e grandes marcas.
      </p>
    </div>

    <div class="footer-nav-col">
      <h4 class="footer-col-title" data-i18n-pt="Navegação" data-i18n-en="Navigation">Navegação</h4>
      <ul class="footer-list">
        <li><a href="/sobre" data-i18n-pt="A Stampaholics" data-i18n-en="About Us">A Stampaholics</a></li>
        <li><a href="/produtos" data-i18n-pt="Catálogo Completo" data-i18n-en="Product Catalog">Catálogo Completo</a></li>
        <li><a href="/servicos" data-i18n-pt="Serviços & Tecidos" data-i18n-en="Services & Fabrics">Serviços & Tecidos</a></li>
        <li><a href="/clientes" data-i18n-pt="Clientes & Cases" data-i18n-en="Clients & Cases">Clientes & Cases</a></li>
      </ul>
    </div>

    <div class="footer-nav-col">
      <h4 class="footer-col-title" data-i18n-pt="Suporte & Dúvidas" data-i18n-en="Support & FAQ">Suporte & Dúvidas</h4>
      <ul class="footer-list">
        <li><a href="/faq" data-i18n-pt="Dúvidas Frequentes (FAQ)" data-i18n-en="Frequently Asked Questions">Dúvidas Frequentes (FAQ)</a></li>
        <li><a href="/contato" data-i18n-pt="Formulário de Contato" data-i18n-en="Contact Form">Formulário de Contato</a></li>
        <li><a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer">WhatsApp Comercial</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom-line">
    <div class="container footer-bottom-content">
      <p>© {new Date().getFullYear()} Stampaholics Têxtil. São Paulo - SP.</p>
      <span class="footer-badge-mono">Sublimação Digital & Laser Cut</span>
    </div>
  </div>
</footer>

<style>
  .boutique-footer {
    background: var(--bg-dark);
    border-top: 1px solid var(--border-dark);
    padding-top: 64px;
    color: var(--text-white-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
  }

  .footer-brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .footer-heart {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.6;
    max-width: 380px;
    color: var(--text-white-muted);
  }

  .footer-col-title {
    font-size: 13px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    margin-bottom: 18px;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-list a {
    font-size: 14px;
    color: var(--text-white-muted);
    transition: color 0.2s;
  }

  .footer-list a:hover {
    color: var(--brand-pink);
  }

  .footer-bottom-line {
    border-top: 1px solid var(--border-dark);
    padding: 24px 0;
    font-size: 12.5px;
    color: #64748B;
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-badge-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--brand-green);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
