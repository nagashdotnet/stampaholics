---
interface Props {
  size?: number;
}

const { size = 200 } = Astro.props;
---

<div class="heart-logo-3d-wrapper" style={`width: ${size}px; height: ${size}px;`}>
  <canvas id="heart-logo-3d-canvas" class="heart-logo-canvas"></canvas>
</div>

<style>
  .heart-logo-3d-wrapper {
    position: relative;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .heart-logo-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    cursor: grab;
    outline: none;
  }

  .heart-logo-canvas:active {
    cursor: grabbing;
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('heart-logo-3d-canvas') as HTMLCanvasElement | null;
  const wrapper = canvas?.parentElement;

  if (canvas && wrapper) {
    const scene = new THREE.Scene();

    const w = wrapper.clientWidth || 200;
    const h = wrapper.clientHeight || 200;

    const camera = new THREE.PerspectiveCamera(40, w / h, 0.1, 50);
    camera.position.set(0, 0, 6.2);

    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    // ==========================================
    // GEOMETRIA DOS 6 TRIÂNGULOS EXATOS DO LOGO
    // ==========================================
    // Pontos chave 2D conforme o logo vetorial oficial:
    // P0: Topo do entalhe em V (0, 0.4)
    // P1: Asa superior esquerda (-1.1, 1.45)
    // P2: Asa superior direita (1.1, 1.45)
    // P3: Canto lateral esquerdo (-1.7, 0.4)
    // P4: Canto lateral direito (1.7, 0.4)
    // P5: Junção inferior esquerda (-0.85, -0.6)
    // P6: Junção inferior direita (0.85, -0.6)
    // P7: Ponta inferior mais baixa (0, -1.95)

    // Coordenadas 3D com curvatura/relevo de origami (Z frontal sutilmente angulado):
    const vertices = [
      // 0: P0 (Centro V)
      0.0, 0.4, 0.25,
      // 1: P1 (Topo Esq)
      -1.1, 1.45, 0.1,
      // 2: P2 (Topo Dir)
      1.1, 1.45, 0.1,
      // 3: P3 (Lateral Esq)
      -1.7, 0.4, -0.05,
      // 4: P4 (Lateral Dir)
      1.7, 0.4, -0.05,
      // 5: P5 (Meio Baixo Esq)
      -0.85, -0.6, 0.35,
      // 6: P6 (Meio Baixo Dir)
      0.85, -0.6, 0.35,
      // 7: P7 (Ponta Inferior)
      0.0, -1.95, 0.05,

      // Vértices Traseiros (para volume sólido chanfrado 3D)
      0.0, 0.4, -0.25,      // 8
      -1.1, 1.45, -0.1,     // 9
      1.1, 1.45, -0.1,      // 10
      -1.7, 0.4, -0.25,     // 11
      1.7, 0.4, -0.25,      // 12
      -0.85, -0.6, -0.35,   // 13
      0.85, -0.6, -0.35,    // 14
      0.0, -1.95, -0.05     // 15
    ];

    const indices = [
      // === Face Frontal: Os 6 Triângulos Oficiais ===
      // T1: Asa Superior Esquerda
      3, 1, 0,
      // T2: Asa Superior Direita
      0, 2, 4,
      // T3: Lateral Esquerda
      3, 0, 5,
      // T4: Centro Invertido (O delta central)
      5, 0, 6,
      // T5: Lateral Direita
      0, 4, 6,
      // T6: Ponta Inferior
      5, 6, 7,

      // === Face Traseira ===
      11, 8, 9,
      8, 12, 10,
      11, 13, 8,
      13, 14, 8,
      8, 14, 12,
      13, 15, 14,

      // === Chanfros e Laterais de Fechamento ===
      3, 11, 1,   1, 11, 9,
      1, 9, 0,    0, 9, 8,
      0, 8, 2,    2, 8, 10,
      2, 10, 4,   4, 10, 12,
      4, 12, 6,   6, 12, 14,
      6, 14, 7,   7, 14, 15,
      7, 15, 5,   5, 15, 13,
      5, 13, 3,   3, 13, 11
    ];

    const geom = new THREE.BufferGeometry();
    geom.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
    geom.setIndex(indices);
    geom.computeVertexNormals();

    // Material de Seda Têxtil Pink da Marca (#EB2C65)
    const material = new THREE.MeshPhysicalMaterial({
      color: 0xEB2C65,
      emissive: 0x380012,
      emissiveIntensity: 0.12,
      roughness: 0.25,
      metalness: 0.08,
      clearcoat: 0.85,
      clearcoatRoughness: 0.15,
      sheen: 1.0,
      sheenColor: new THREE.Color(0xFF8AB0),
      sheenRoughness: 0.25,
      flatShading: true // Preserva os 6 triângulos nítidos!
    });

    const heartMesh = new THREE.Mesh(geom, material);
    heartMesh.scale.set(0.95, 0.95, 0.95);
    scene.add(heartMesh);

    // Iluminação
    const amb = new THREE.AmbientLight(0xFFFFFF, 0.9);
    scene.add(amb);

    const key = new THREE.DirectionalLight(0xFFE5EE, 2.5);
    key.position.set(2, 3, 4);
    scene.add(key);

    const fill = new THREE.DirectionalLight(0x274D5E, 1.8);
    fill.position.set(-3, -2, 2);
    scene.add(fill);

    const rim = new THREE.PointLight(0x1FB380, 2.0, 8);
    rim.position.set(0, -2, -2.5);
    scene.add(rim);

    // Rastreamento suave do mouse
    let targetX = 0;
    let targetY = 0;
    let currX = 0;
    let currY = 0;

    window.addEventListener('mousemove', (e) => {
      const rect = wrapper.getBoundingClientRect();
      const x = ((e.clientX - (rect.left + rect.width / 2)) / window.innerWidth) * 2;
      const y = ((e.clientY - (rect.top + rect.height / 2)) / window.innerHeight) * 2;

      targetY = x * 0.7;
      targetX = -y * 0.5;
    });

    let clock = new THREE.Clock();

    function render() {
      requestAnimationFrame(render);
      const time = clock.getElapsedTime();

      // Levitação suave
      const floatY = Math.sin(time * 1.8) * 0.08;
      heartMesh.position.y = floatY;

      // Amortecimento elástico LERP
      currX += (targetX - currX) * 0.05;
      currY += (targetY - currY) * 0.05;

      heartMesh.rotation.x = currX;
      heartMesh.rotation.y = currY + Math.sin(time * 0.6) * 0.05;

      renderer.render(scene, camera);
    }

    render();
  }
</script>
